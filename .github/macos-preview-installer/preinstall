#!/bin/bash
set -euo pipefail
# The preview may replace only another preview. Production Nevis/Noviq are never touched.
target="${3:-/}"
app="${target%/}/Applications/Nevis GitHub Preview.app"
if [[ -e "$app" || -L "$app" ]]; then
  if [[ -L "$app" ]] || [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Contents/Info.plist" 2>/dev/null || true)" != com.vexor.noviq.githubpreview ]]; then
    echo 'The preview destination contains another application. Nothing was replaced.' >&2
    exit 1
  fi
  if /bin/ps -axo command= | /usr/bin/grep -F "$app/Contents/MacOS/" | /usr/bin/grep -v grep >/dev/null; then
    echo 'Close Nevis GitHub Preview before installing this test build.' >&2
    exit 1
  fi
fi
