{
  "name": "nevis",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "corepack pnpm -r --if-present typecheck",
    "test": "corepack pnpm -r --if-present test",
    "dev:server": "cd server && DEV_MODE=1 DEV_TOKEN=dev PORT=8787 go run ./cmd/nevis-server",
    "converge": "corepack pnpm --filter @nevis/converge converge",
    "test:go": "cd server && go test ./... -race",
    "test:long": "SEEDS=200 OPS=2000 corepack pnpm --filter @nevis/converge test",
    "test:all": "corepack pnpm test && corepack pnpm test:go",
    "nevis-log": "corepack pnpm --filter @nevis/nevis-log start",
    "bench:startup": "corepack pnpm --filter @nevis/bench start",
    "bench:search": "corepack pnpm --filter @nevis/search bench",
    "check": "depcruise --config .dependency-cruiser.cjs apps/web/src packages/core/src packages/editor/src packages/schema/src && node tools/depcheck/test.mjs && corepack pnpm typecheck",
    "nevis": "corepack pnpm --filter @nevis/bundle nevis"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "dependency-cruiser": "18.7.2",
    "fast-check": "4.10.3",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}