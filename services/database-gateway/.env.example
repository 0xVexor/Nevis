# Copy to .env and load it into the environment before `npm start`, e.g. `node --env-file=.env src/main.ts`.
# The gateway never reads secrets from the Vault; credentials for outbound messages live in the connections file below.

# Listening address. In production put the gateway behind HTTPS (a reverse proxy) and bind to 127.0.0.1.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
# Path of the SQLite file. Back it up like any other database.
GATEWAY_DB=./data/gateway.sqlite
# Public base URL that forms are published under (used to build links). No trailing slash.
GATEWAY_PUBLIC_URL=https://forms.example.com
# Owner API token: at least 32 random characters (for example `openssl rand -base64 36`). Only its hash is stored.
GATEWAY_OWNER_TOKEN=
# Outbound webhooks may only call these hosts (comma separated). Empty = any public https host.
GATEWAY_WEBHOOK_ALLOWLIST=
# JSON file with connection secrets: { "<connectionId>": { "headers": { "Authorization": "Bearer ..." } } }
GATEWAY_CONNECTIONS_FILE=
# Maximum request body in bytes (default 1 MB) and requests per minute per form and client.
GATEWAY_MAX_BODY=1048576
GATEWAY_RATE_PER_MINUTE=30
# Development only: allow http://localhost webhooks and create a loopback-only owner token when GATEWAY_OWNER_TOKEN is empty.
# Refused unless GATEWAY_HOST is a loopback address.
GATEWAY_DEV=0
