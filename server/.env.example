# The server reads real environment variables (a systemd EnvironmentFile works, see README.md); it does not read this file itself.
# Never commit real secrets.

SESSION_SECRET=change-me-to-a-random-string-of-32-or-more-characters
REGISTRATION=invite
INVITE_CODES=first-invite:1,friends:20
LISTEN_HOST=127.0.0.1
PORT=3000
DATA_DIR=/var/lib/nevis
# Behind a reverse proxy on the same machine:
TRUST_PROXY=loopback

# QUOTA_MB=1024
# RETENTION_DAYS=30
# BACKUP_DELAY_SEC=20
# BACKUP_KEEP=24
