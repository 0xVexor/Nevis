# Copy to .env for local use (the server reads real environment variables; on Liara set them in the panel).
# Never commit real keys. Anything that has been in a screenshot, a chat or a commit is compromised: make new ones.

SESSION_SECRET=change-me-to-a-random-string-of-32-or-more-characters
REGISTRATION=invite
INVITE_CODES=first-invite:1,friends:20
NODE_ENV=production
PORT=3000

# S3 compatible object storage (leave S3_BUCKET unset to keep blobs on disk, for development)
S3_ENDPOINT=https://storage.example.com
S3_BUCKET=your-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# DATA_DIR=/data
# QUOTA_MB=1024
# RETENTION_DAYS=30
