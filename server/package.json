{
  "name": "noviq-sync-server",
  "version": "0.1.0",
  "private": true,
  "description": "Sync server for Noviq: accounts, per-vault revisions, content-addressed blobs on S3 and instant change notification.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test \"test/*.test.js\"",
    "check": "node scripts/check-storage.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "fastify": "^5.12.7"
  }
}
