{
  "name": "nevis",
  "private": true,
  "version": "1.1.0-beta.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "build:documents": "tsc -p tsconfig.documents.json",
    "test:misc": "node --test ../../db/test-crash.mjs ../../db/test-detect.mjs ../../db/test-mermaid-detect.mjs ../../db/test-schema.mjs ../../db/test-srs.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "check:ui": "node scripts/check-ui.mjs",
    "test:layout": "node --import ./tests/register.mjs --test \"./tests/*.test.mjs\"",
    "test:updates": "node --test ../../db/test-updates.mjs",
    "test:document-persistence": "npm run -s build:documents && node --test ../../db/test-document-service.mjs ../../db/tests/database/idb.test.mjs src/editor/documentCommitGuard.test.mjs",
    "test:document-operations": "npm run -s build:documents && node --test ../../db/test-document-operations.mjs",
    "test:document-planner": "npm run -s build:documents && node --test ../../db/test-document-planner.mjs",
    "test:document-edit-commits": "npm run -s build:documents && node --test ../../db/test-document-edit-commits.mjs",
    "test:document-history": "npm run -s build:documents && node --test ../../db/test-document-history.mjs",
    "test:document-mutations": "npm run -s build:documents && node --test ../../db/test-document-mutations.mjs",
    "test:document-reads": "npm run -s build:documents && node --test ../../db/test-document-reads.mjs",
    "test:document-search": "npm run -s build:documents && node --test ../../db/test-document-search.mjs",
    "test:search-freshness": "npm run -s build:documents && node --test ../../db/test-search-freshness.mjs",
    "test:direction": "node --test src/editor/direction.test.mjs",
    "test:documents": "npm run -s build:documents && node --test ../../db/test-agent-documents.mjs ../../db/test-document-projection.mjs ../../db/test-document-contracts.mjs ../../db/test-block-identity.mjs ../../db/test-repo-identity.mjs ../../db/test-document-service.mjs ../../db/test-document-operations.mjs ../../db/test-document-planner.mjs ../../db/test-document-edit-commits.mjs ../../db/test-document-mutations.mjs ../../db/test-document-history.mjs ../../db/test-document-mcp.mjs ../../db/test-document-tables.mjs ../../db/test-document-admission.mjs ../../db/test-document-reads.mjs ../../db/test-document-search.mjs ../../db/test-search-freshness.mjs src/editor/blockIdentity.test.mjs src/editor/documentCommitGuard.test.mjs",
    "test:db": "node --test \"../../db/tests/database/*.test.mjs\"",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:document-mcp": "npm run -s build:documents && node --test ../../db/test-document-mcp.mjs",
    "test:document-tables": "npm run -s build:documents && node --test ../../db/test-document-tables.mjs",
    "dev:settings": "vite --config vite.settings.config.ts",
    "build:settings": "tsc -p tsconfig.app.json --noEmit --incremental false && vite build --config vite.settings.config.ts"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/estedad": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/noto-kufi-arabic": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/vazirmatn": "^5.3.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-notification": "^2.7.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "katex": "^0.19.1",
    "lowlight": "^3.3.0",
    "marked": "^18.1.1",
    "mermaid": "^12.2.0",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
