{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noviq",
  "version": "0.2.0",
  "identifier": "com.vexor.noviq",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Noviq.", "width": 1280, "height": 820, "minWidth": 720, "minHeight": 520, "dragDropEnabled": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
