# Copy to /etc/nevis/env (chmod 600) and fill in. Every line is read by nevis-server.
# A random string of at least 32 characters: it signs the sign-up challenges. Make one with:  openssl rand -hex 32
SESSION_SECRET=CHANGE-ME
# invite = only people with a code below can sign up; open = anyone can (do not use open on the internet)
REGISTRATION=invite
# comma separated; give one to each person you invite, remove it when they are in
INVITE_CODES=CHANGE-ME-first-code
# where the database, the attachments and the daily backups live: put it on a disk you back up
DATA_DIR=/var/lib/nevis
# the folder of the web app (the `web` folder of the release)
WEB_DIR=/opt/nevis/web
# the server listens on this address; the reverse proxy (Caddy) is the only thing that talks to it
LISTEN_HOST=127.0.0.1
PORT=8787
# optional: storage per account and the largest single file, in MB
QUOTA_MB=1024
MAX_BLOB_MB=100
